# ~/.config/cc-panel/env  (chmod 600, generated by install.sh)
BIND_HOST=100.x.y.z          # Tailscale IP: the panel is a web terminal, never bind it publicly
BIND_PORT=8790
PANEL_USER=dev
PANEL_PASSWORD=change-me     # changing it logs out every browser
TTYD_SOCK=/run/user/2600/cc-ttyd.sock
# PROJECTS_DIR=~/projects
